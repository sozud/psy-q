# Note:
# This Makefile is for GNU compiler in UNIX
# You have to change this for PC environment. Sorry.
#
# 'makdfile.mak' is a sample Makefile in PC environment.
# It must help you to convert this Makefile
#
# This Makefile for DTL-H5000K of NEWS-OS 6.X.
#

LIBDIR	= ../../../../lib
INCDIR	= ../../../../include
MAKE	= make
TADDR	= 80100000
CC	= cc -O2
CFLAGS	= -I -I$(INCDIR) -coff -EL -non_shared -Wx,-G 0 
LDFLAGS	= -EL -L$(LIBDIR) -coff -non_shared -Wx,-G 0 -N -T $(TADDR) -e main
RM	= rm -f
RM_CMD	= $(RM) *.CKP *.ln *.BAK *.bak *.o core errs ,* *~ *.a .emacs_* tags \
	 	TAGS make.log MakeOut
DEPEND	= makedepend
LIBS	= -lgs -lgpu -lgte -letc -lc2 -lapi

OBJS0	= tuto0.o
OBJS1	= tuto1.o
OBJS2	= tuto2.o
OBJS3	= tuto3.o

all::	tuto0 tuto1 tuto2 tuto3
tuto0 : $(OBJS0)
	ld $(LDFLAGS) -o tuto0 $(OBJS0) $(LIBS)

tuto1 : $(OBJS1)
	ld $(LDFLAGS) -o tuto1 $(OBJS1) $(LIBS)

tuto2 : $(OBJS2)
	ld $(LDFLAGS) -o tuto2 $(OBJS2) $(LIBS)

tuto3 : $(OBJS3)
	ld $(LDFLAGS) -o tuto3 $(OBJS3) $(LIBS)

clean::
	$(RM) tuto[0-9]
	$(RM_CMD) "#"*

depend::
	$(DEPEND) $(DEPENDFLAGS) -s "# DO NOT DELETE" -- -I$(INCDIR) -- *.c

start0:
	bload tri.hmd 80010000
#	bload dino.hmd 80010000
#	bload cube.hmd 80010000
#	bload tile.hmd 80010000
	aload tuto0
	squit

start1:
	bload flag.hmd 80010000
	aload tuto1
	squit

start2:
	bload shuttle.hmd 80010000
	aload tuto2
	squit

start3:
	bload jimen.hmd 80010000
	aload tuto3
	squit

