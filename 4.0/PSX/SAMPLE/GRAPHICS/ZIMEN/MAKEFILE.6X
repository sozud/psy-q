# Note:
# This Makefile is for GNU compiler in UNIX
# You have to change this for PC environment. Sorry.
#
# 'makdfile.mak' is a sample Makefile in PC environment.
# It must help you to convert this Makefile
#
# This Makefile for DTL-H5000K of NEWS-OS 6.X.
#

LIBDIR   = /usr/sony/psx/lib
INCDIR   = /usr/sony/psx/include

MAKE	 = make
TADDR	 = 80010000
CC       = /usr/sony/psx/bin/gcc-el -O2 
CFLAGS   = -I$(INCDIR)  -EL -non_shared -G0 -Wa,"-G 0" -Wa,"-coff" -Wa,"-non_shared"
ASFLAGS   = -I$(INCDIR) -EL -coff -Wx,-G 0 -O2
LDFLAGS  = -L$(LIBDIR) -g -coff -EL -non_shared -Wx,-G 0 -N -T $(TADDR) \
           -e main
RM       = rm -f
RM_CMD   = $(RM) *.CKP *.ln *.BAK *.bak *.o core errs ,* *~ *.a .emacs_* tags TAGS make.log MakeOut
DEPEND   = makedepend
LIBS     = -lgs -lgpu -lgte -letc -lc -lapi 

all::	tuto0 tuto1 tuto2 tuto3 tuto4 tuto5

libzimen.a : clip.c bgtex.c db.c mesh.c geom.c pad.c debug.c map.c config.c div.c
	$(CC) $(CFLAGS) -c clip.c
	$(CC) $(CFLAGS) -c bgtex.c
	$(CC) $(CFLAGS) -c db.c
	$(CC) $(CFLAGS) -c mesh.c
	$(CC) $(CFLAGS) -c geom.c
	$(CC) $(CFLAGS) -c pad.c
	$(CC) $(CFLAGS) -c debug.c
	$(CC) $(CFLAGS) -c map.c
	$(CC) $(CFLAGS) -c config.c
	$(CC) $(CFLAGS) -c div.c
	dmpsx div.o
	$(RM)  libzimen.a
	ar cru libzimen.a clip.o bgtex.o db.o mesh.o geom.o pad.o debug.o map.o config.o div.o


tuto0: tuto0.c libzimen.a
	$(CC) $(CFLAGS) -c tuto0.c 
	ld $(LDFLAGS) -o tuto0 $(LIBDIR)/8mbyte.o tuto0.o libzimen.a  $(LIBS) 
tuto1: tuto1.c libzimen.a
	$(CC) $(CFLAGS) -DVIEW_CLIP -DNO_DIV -c tuto1.c 
	ld $(LDFLAGS) -o tuto1 $(LIBDIR)/8mbyte.o tuto1.o libzimen.a  $(LIBS) 
tuto2: tuto1.c libzimen.a
	$(CC) $(CFLAGS) -DNO_DIV -c tuto1.c -o tuto2.o
	ld $(LDFLAGS) -o tuto2 $(LIBDIR)/8mbyte.o tuto2.o libzimen.a  $(LIBS) 
tuto3: tuto1.c libzimen.a
	$(CC) $(CFLAGS) -DRAP_ROUND -DNO_DIV -c tuto1.c -o tuto3.o
	ld $(LDFLAGS) -o tuto3 $(LIBDIR)/8mbyte.o tuto3.o libzimen.a  $(LIBS) 
tuto4: tuto1.c libzimen.a
	$(CC) $(CFLAGS) -DRAP_ROUND -c tuto1.c -o tuto4.o
	ld $(LDFLAGS) -o tuto4 $(LIBDIR)/8mbyte.o tuto4.o libzimen.a  $(LIBS) 
tuto5: tuto5.o bg.o bgtex8.o
	ld $(LDFLAGS) -o tuto5 $(LIBDIR)/8mbyte.o tuto5.o bg.o bgtex8.o  $(LIBS) 


clean::
	$(RM) balls *.exe
	$(RM_CMD) "#"*

depend::
	$(DEPEND) $(DEPENDFLAGS) -s "# DO NOT DELETE" -- -I$(INCDIR) -- *.c


