# Note:
# This Makefile is for GNU compiler in UNIX
# You have to change this for PC environment. Sorry.
#
# 'makdfile.mak' is a sample Makefile in PC environment.
# It must help you to convert this Makefile
#
# This Makefile for DTL-H5000K of NEWS-OS 6.X.
#

# LIBDIR   = ../../../lib
# INCDIR   = ../../../include
LIBDIR   = /usr/sony/psx/lib
INCDIR   = /usr/sony/psx/include

MAKE	 = make
TADDR	 = 800a0000
CC       = cc -O2
CFLAGS   = -I -I$(INCDIR) -coff -EL -non_shared -Wx,-G 0
LDFLAGS  = -L -L$(LIBDIR) -coff -EL -non_shared -Wx,-G 0 -N -T $(TADDR) \
           -e start
RM       = rm -f
RM_CMD   = $(RM) *.CKP *.ln *.BAK *.bak *.o core errs ,* *~ *.a .emacs_* tags TAGS make.log MakeOut
DEPEND   = makedepend
LIBS     = -lsnd -lspu -lpress -lgs -lgpu -lgte -lcd -letc -lc -lapi

OBJS     = main.o
all::	main
main : $(OBJS)
	ld $(LDFLAGS) -o main $(LIBDIR)/8mbyte.o  $(OBJS) $(LIBS)

for_menu : $(OBJS)
	ld $(LDFLAGS) -o main $(LIBDIR)/none2.o  $(OBJS) $(LIBS)
	out2x balls

load:
	psxbload giuli_bd.tim 80010000
	psxbload giuli_fr.tim 80020000
	psxbload giuli_pl.tim 80030000
	psxbload giuli_tl.tim 80040000
	psxbload giuli_tr.tim 80050000
	psxbload giuli_wn.tim 80060000
	psxbload wheel256.tim 80070000
	psxbload giulieta.tmd 80080000

clean::
	$(RM) balls *.exe
	$(RM_CMD) "#"*

depend::
	$(DEPEND) $(DEPENDFLAGS) -s "# DO NOT DELETE" -- -I$(INCDIR) -- *.c

start:
	psxexec balls 807ffff0

