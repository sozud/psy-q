# Note:
# This Makefile is for GNU compiler in UNIX
# You have to change this for PC environment. Sorry.
#
# 'makdfile.mak' is a sample Makefile in PC environment.
# It must help you to convert this Makefile
#
# This Makefile for DTL-H5000K of NEWS-OS 6.X.
#

LIBDIR   = /usr/sony/psx/lib
INCDIR   = /usr/sony/psx/include

MAKE	 = make
TADDR	 = 80080000
CC       = /usr/sony/psx/bin/gcc-el -O2 
CFLAGS   = -I$(INCDIR)  -EL -non_shared -G0 -Wa,"-G 0" -Wa,"-coff" -Wa,"-non_shared"
ASFLAGS   = -I$(INCDIR) -EL -coff -Wx,-G 0 -O2
LDFLAGS  = -L$(LIBDIR) -g -coff -EL -non_shared -Wx,-G 0 -N -T $(TADDR) \
           -e main
RM       = rm -f
RM_CMD   = $(RM) *.CKP *.ln *.BAK *.bak *.o core errs ,* *~ *.a .emacs_* tags TAGS make.log MakeOut
DEPEND   = makedepend
LIBS     = -lgs -lgpu -lgte -letc -lc -lapi 

TUTO0	= tuto0.o
TUTO1   = tuto1.o g4l.o tg4l.o g4lfg.o tg4lfg.o g4nl.o tg4nl.o
TUTO2	= tuto2.o g4trr.o tg4trr.o
TUTO3	= tuto3.o g4l.o tg4lmip.o

all::	tuto0 tuto2 tuto3

g4l.o:
	$(CC) $(CFLAGS) -c g4l.c
	dmpsx g4l.o

tg4l.o:
	$(CC) $(CFLAGS) -c tg4l.c
	dmpsx tg4l.o

g4lfg.o:
	$(CC) $(CFLAGS) -c g4lfg.c
	dmpsx g4lfg.o

g4nl.o:
	$(CC) $(CFLAGS) -c g4nl.c
	dmpsx g4nl.o

tg4nl.o:
	$(CC) $(CFLAGS) -c tg4nl.c
	dmpsx g4nl.o

g4trr.o:
	$(CC) $(CFLAGS) -c g4trr.c
	dmpsx g4trr.o

tg4trr.o:
	$(CC) $(CFLAGS) -c tg4trr.c
	dmpsx tg4trr.o

tg4lmip.o:
	$(CC) $(CFLAGS) -c tg4lmip.c
	dmpsx tg4lmip.o

tuto0: $(TUTO0)
	ld $(LDFLAGS) -o tuto0 $(LIBDIR)/8mbyte.o $(TUTO0) $(LIBS) 
tuto1: $(TUTO1)
	ld $(LDFLAGS) -o tuto1 $(LIBDIR)/8mbyte.o $(TUTO1) $(LIBS) 
tuto2: $(TUTO2)
	ld $(LDFLAGS) -o tuto2 $(LIBDIR)/8mbyte.o $(TUTO2) $(LIBS) 
tuto3: $(TUTO3)
	ld $(LDFLAGS) -o tuto3 $(LIBDIR)/8mbyte.o $(TUTO3) $(LIBS) 

for_menu : 
	ld $(LDFLAGS) -o tuto0 $(LIBDIR)/none2.o  $(TUTO0) $(LIBS)
	out2x tuto0
	ld $(LDFLAGS) -o tuto1 $(LIBDIR)/none2.o  $(TUTO1) $(LIBS)
	out2x tuto1
	ld $(LDFLAGS) -o tuto2 $(LIBDIR)/none2.o  $(TUTO2) $(LIBS)
	out2x tuto2
	ld $(LDFLAGS) -o tuto3 $(LIBDIR)/none2.o  $(TUTO3) $(LIBS)
	out2x tuto3

clean::
	$(RM) balls *.exe
	$(RM_CMD) "#"*

depend::
	$(DEPEND) $(DEPENDFLAGS) -s "# DO NOT DELETE" -- -I$(INCDIR) -- *.c

# -------------------------------------------------------------------------
# dependencies generated by makedepend

# DO NOT DELETE

